# ═══════════════════════════════════════════════════════════════
#  .gitignore — Kisan Mitra (Monorepo)
#  NEVER push API keys, secrets, or large model files to GitHub.
# ═══════════════════════════════════════════════════════════════

# ─── Environment Variables (CRITICAL — contains API keys) ─────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# ─── ML Model Files (too large for GitHub — host separately) ──
*.pkl
*.keras
*.h5
*.pt
*.pth
*.onnx
*.tflite
*.pb
*.savedmodel/

# Allow specific ML models needed for deployment
!Backend/Crop recommendation/crop_model.pkl
!Backend/Crop recommendation/crop_scaler.pkl
!Backend/Disease prediction/model/plant_disease_model.keras


# ─── Datasets (too large for GitHub) ──────────────────────────
Backend/Crop recommendation/dataset/
Backend/Disease prediction/dataset/
Backend/Disease prediction/report/

# ─── Node / Next.js ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
.pnpm-debug.log*
.next/
out/

# ─── ChromaDB vector store ────────────────────────────────────
chroma_db/

# ─── IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# ─── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Misc ─────────────────────────────────────────────────────
.sixth/
*.log
