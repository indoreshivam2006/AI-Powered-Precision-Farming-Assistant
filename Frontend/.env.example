# ─── Frontend Environment Variables ───────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git!

# data.gov.in API key for real-time mandi prices
# Get from: https://data.gov.in/
DATA_GOV_API_KEY=your_data_gov_api_key_here

# ─── Backend URLs (for Vercel production deployment) ──────────
# These point to your Render-hosted backend services.
# Leave empty for local development (defaults to localhost).

# AI Advisory service (Render Web Service URL)
ADVISORY_API_URL=https://your-advisory-service.onrender.com

# Disease Prediction service (Render Web Service URL)  
NEXT_PUBLIC_DISEASE_API_URL=https://your-disease-service.onrender.com

# Crop Recommendation service (Render Web Service URL)
NEXT_PUBLIC_CROP_API_URL=https://your-crop-service.onrender.com
