# KisanMitra Advisory Agent — Environment Variables
# Copy this to .env and fill in your values

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Gemini fallback API key (get from Google AI Studio)
# Used only when the primary Groq advisory agent is unavailable
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Government mandi price API key (get from https://data.gov.in)
DATA_GOV_API_KEY=your_data_gov_api_key_here

# Team API base URL (swap when team's APIs are deployed)
TEAM_BASE_URL=http://localhost:8000

# Backend self-URL (used by WhatsApp handler in production)
BACKEND_URL=http://localhost:8080

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000
